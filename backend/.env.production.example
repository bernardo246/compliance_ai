# Modelo de variáveis para PRODUÇÃO. Copie para backend/.env.production (ignorado
# pelo git) ou, melhor, cadastre cada variável no painel/secrets manager do
# provedor de deploy. NUNCA commite valores reais.
#
# Em NODE_ENV=production o backend valida estas variáveis no boot
# (src/config/production-checks.ts): se faltar algo essencial ou o Redis apontar
# para localhost, ele aborta com a lista de problemas.

# ---------- Servidor ----------
NODE_ENV=production
PORT=3001
# URL pública do frontend, em HTTPS: o cookie do refresh token é "secure" em
# produção e o navegador não o envia por HTTP.
FRONTEND_URL=https://seu-frontend.exemplo.com
# true só se houver um load balancer/proxy confiável na frente (quase sempre há
# em produção). O número de saltos assumido é 1: se houver CDN + load balancer,
# ajuste o `trust proxy` em src/main.ts.
TRUST_PROXY=true
# Nunca ligar em produção.
ENABLE_DEBUG_ENDPOINT=false

# ---------- Redis gerenciado ----------
# rediss:// = TLS. Use usuário/senha do provedor na URL.
# O Redis deve ter maxmemory-policy=noeviction (o BullMQ avisa no boot se não
# tiver) e persistência ligada.
REDIS_URL=rediss://default:SENHA@HOST-DO-REDIS:PORTA

# ---------- Supabase ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# ---------- JWT (RS256) — gere um par NOVO para produção (README, seção 2) ----------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=cole-aqui-a-chave-da-openrouter
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MAX_TOKENS=32000
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=2

# ---------- Aplicação ----------
TERMS_CURRENT_VERSION=1.0.0
MAX_UPLOAD_SIZE_MB=20
ANALYSIS_STUCK_TIMEOUT_MS=600000
ANALYSIS_RECOVERY_INTERVAL_MS=300000

# ---------- ClamAV (opcional) ----------
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
