# Modelo de variáveis para PRODUÇÃO. Copie para backend/.env.production (ignorado
# pelo git) ou, melhor, cadastre cada variável no painel/secrets manager do
# provedor de deploy. NUNCA commite valores reais.
#
# Quem usa este arquivo é o docker-compose.prod.yml (o que roda na VM). O número de
# réplicas NÃO é definido aqui: é a variável BACKEND_REPLICAS do próprio compose
# (BACKEND_REPLICAS=3 docker compose -f docker-compose.prod.yml up -d --build).
#
# Em NODE_ENV=production o backend valida estas variáveis no boot
# (src/config/production-checks.ts): se faltar algo essencial ou o Redis apontar
# para localhost, ele aborta com a lista de problemas.

# ---------- Servidor ----------
NODE_ENV=production
PORT=3001
# URL pública do frontend, em HTTPS: o cookie do refresh token é "secure" em
# produção e o navegador não o envia por HTTP.
FRONTEND_URL=https://seu-frontend.exemplo.com
# true só se houver um load balancer/proxy confiável na frente (quase sempre há
# em produção). O número de saltos assumido é 1: se houver CDN + load balancer,
# ajuste o `trust proxy` em src/main.ts.
TRUST_PROXY=true
# Nunca ligar em produção.
ENABLE_DEBUG_ENDPOINT=false

# ---------- Redis gerenciado ----------
# rediss:// = TLS. Use usuário/senha do provedor na URL.
# O Redis deve ter maxmemory-policy=noeviction (o BullMQ avisa no boot se não
# tiver) e persistência ligada.
# Se o serviço usar uma CA própria (não pública), veja as linhas opcionais no
# docker-compose.prod.yml (NODE_EXTRA_CA_CERTS e o volume ./certs/redis-ca.pem).
REDIS_URL=rediss://default:SENHA@HOST-DO-REDIS:PORTA

# ---------- Supabase ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# ---------- JWT (RS256) — gere um par NOVO para produção (README, seção 2) ----------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Quanto tempo um refresh token JÁ USADO fica no banco (só serve para detectar o reuso dele como
# roubo). Menor = menos linhas na tabela refresh_tokens. Padrão 1 hora (3600000), mínimo 1 minuto.
REFRESH_REVOKED_RETENTION_MS=3600000

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=cole-aqui-a-chave-da-openrouter
# --- Modelo de IA: ESCOLHA CONSCIENTE (afeta a privacidade dos documentos) ---
# Opção A (padrão aqui): modelo GRATUITO. Os modelos ":free" só respondem se o provedor puder guardar
#   e usar o conteúdo para treino (OPENROUTER_DATA_COLLECTION=allow). O Termo de Uso passa a avisar isso
#   sozinho (o backend informa em GET /api/privacy-info). Limite diário baixo: quando acaba, as análises
#   terminam em erro até o dia seguinte. O boot sobe, com avisos no log.
# Opção B: modelo PAGO (slug em https://openrouter.ai/models, sem ":free") com
#   OPENROUTER_DATA_COLLECTION=deny: só provedores que não guardam nem treinam com o conteúdo.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DATA_COLLECTION=allow
OPENROUTER_MAX_TOKENS=32000
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=2

# ---------- Aplicação ----------
TERMS_CURRENT_VERSION=1.1.0
MAX_UPLOAD_SIZE_MB=20
ANALYSIS_STUCK_TIMEOUT_MS=600000
ANALYSIS_RECOVERY_INTERVAL_MS=300000

# ---------- ClamAV (opcional) ----------
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ---------- Alertas de monitoramento ----------
# Um job periódico avalia o sistema (documentos parados, fila acumulada, taxa de erro da IA,
# jobs falhos, rotinas paradas, banco inacessível) e avisa por webhook. Sem URL, os alertas
# só aparecem no log. Slack/Teams/Mattermost: slack | Discord: discord | outro: generic (JSON)
ALERT_WEBHOOK_URL=https://hooks.exemplo.com/SEU-WEBHOOK
ALERT_WEBHOOK_FORMAT=slack
ALERT_CHECK_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=1800000
