# ---------- Servidor ----------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# true só se o backend estiver atrás de um reverse proxy conhecido (produção).
# Em dev local, deixe false.
TRUST_PROXY=false
# Endpoint de diagnóstico /api/debug/instance (público, fora do rate limit).
# Deixe false; o docker-compose.yml local o liga para os testes.
ENABLE_DEBUG_ENDPOINT=false

# ---------- Redis (escala horizontal) ----------
# Estado compartilhado entre réplicas do backend: rate limiter, fila de
# análise (BullMQ) e job de retenção. `localhost` funciona rodando o backend
# direto na máquina (fora de container); dentro do docker-compose, o
# backend usa `redis://redis:6379` (nome do serviço, não localhost — ver
# docker-compose.yml, que já sobrescreve isso via variável de ambiente).
REDIS_URL=redis://localhost:6379
# ---------- Supabase ----------
# Encontrados em Project Settings > API no painel do Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key — fica só no backend, NUNCA no frontend
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
#possivel servive role key = ei2ycUV1oa6dcTpV

# ---------- JWT (RS256) ----------
# Gerar o par de chaves com:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Depois colar o conteúdo aqui (mantendo \n literais ou usando um secrets manager em produção)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...gere com openssl (README, seção 2)...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...gere com openssl (README, seção 2)...\n-----END PUBLIC KEY-----"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Quanto tempo um refresh token JÁ USADO fica no banco (só serve para detectar o reuso dele como
# roubo). Menor = menos linhas na tabela refresh_tokens. Padrão 1 hora (3600000), mínimo 1 minuto.
REFRESH_REVOKED_RETENTION_MS=3600000

# ---------- Termo de uso ----------
TERMS_CURRENT_VERSION=1.1.0

# ---------- Upload ----------
MAX_UPLOAD_SIZE_MB=20
SUPABASE_STORAGE_BUCKET=documents

# ---------- Antivírus no upload (Fase 8) ----------
# false = só a heurística estática de PDF roda (sem dependência externa).
# true = também exige um clamd acessível em CLAMAV_HOST:CLAMAV_PORT (ex.:
# `docker run -p 3310:3310 clamav/clamav`) — se não conseguir falar com ele,
# o upload é recusado (fail closed), não aceito "sem verificar".
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ---------- Pipeline de análise (Fase 5) ----------
# Fila in-process (sem Redis). Quantas análises rodam em paralelo.
# Sem efeito desde a migração para BullMQ: a concorrência do worker é fixa em 2 por réplica.
ANALYSIS_CONCURRENCY=2
# Documento preso em 'processing' há mais que isto é reenfileirado no boot.
ANALYSIS_STUCK_TIMEOUT_MS=600000
# Intervalo da varredura periódica que resgata documentos parados em
# 'uploaded'/'processing' (job repetível do BullMQ). Padrão: 5 min.
ANALYSIS_RECOVERY_INTERVAL_MS=300000

# ---------- OpenRouter (IA) ----------
# Chave de API da OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=cole-aqui-a-chave-da-openrouter
# ⚠️ Confirme o slug exato do modelo em https://openrouter.ai/models
# (filtre por "free") antes de rodar — este é só um palpite informado e pode
# não corresponder ao identificador real/atual do modelo no catálogo deles.
# Conta OpenRouter travada em allowed-providers=nvidia (settings/privacy).
# Modelo testado OK com response_format json_object em 2026-09-09.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free                             #SE QUISER TROCAR O MODELO É SO COLOCAR O SEU API SLUG AQUI
# Checklist jurídico tem ~23 itens verbosos + reasoning tokens do modelo.
# 8000 truncava a resposta no meio (finish_reason=length).
# Só para DESENVOLVIMENTO com modelo ":free": permite que o provedor grátis use o conteúdo para treino.
# Sem isso (padrão "deny") o modelo grátis responde 404. Em produção: deny + modelo pago.
OPENROUTER_DATA_COLLECTION=allow
OPENROUTER_MAX_TOKENS=32000
# Modelo faz reasoning antes de responder — timeout generoso.
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=2
# Opcionais — recomendados pela OpenRouter para atribuição/ranking do app,
# não afetam o funcionamento se deixados em branco.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ---------- Alertas de monitoramento ----------
# Um job periódico avalia o sistema (documentos parados, fila acumulada, taxa de erro da IA,
# jobs falhos, rotinas paradas, banco inacessível) e avisa por webhook. Sem URL, os alertas
# só aparecem no log. Slack/Teams/Mattermost: slack | Discord: discord | outro: generic (JSON)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
ALERT_CHECK_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=1800000
