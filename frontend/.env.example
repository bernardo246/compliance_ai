# Backend rodando direto (npm run start:dev): http://localhost:3001
# Ambiente de várias réplicas atrás do Nginx (docker compose up): http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:3001
# Precisa bater com TERMS_CURRENT_VERSION do backend
NEXT_PUBLIC_TERMS_VERSION=1.1.0
# Termo de Uso e Privacidade (aparece em /termos e /privacidade). OPCIONAL: responsável pelos dados e e-mail
# de contato exibidos no termo. Vazios, o termo usa um texto genérico no lugar.
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_PRIVACY_EMAIL=
